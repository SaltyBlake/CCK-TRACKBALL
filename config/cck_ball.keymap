/*
 * Scroll speed for &msc is in notches per second (smooth scrolling is OFF, so one unit = one
 * mouse-wheel notch). 64/s with a 16 ms trigger period = ~1.02 notch per tick, and the encoder
 * behavior below holds the key for 24 ms (one tick) -> exactly one notch per encoder click.
 */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 64   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

/* No scaler on &msc_input_listener on purpose: the encoder wheel must stay 1 click = 1 notch. */

&msc {
    acceleration-exponent = <0>;   /* constant speed, no ramp-up */
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
    trigger-period-ms = <16>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        /*
         * Mouse-wheel encoder (used by both encoders, on every layer).
         * Clockwise = wheel up (like rolling a mouse wheel forward / zoom in),
         * counter-clockwise = wheel down. To flip direction, swap the two bindings.
         * If one click ever gives 0 or 2 notches, adjust tap-ms (one 16 ms tick fits in 24 ms).
         */
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <24>;
        };
    };

    /*
     * Layers:
     *   0 QWERTY       base layer
     *   1 F_layers     hold F : number row becomes F1-F12
     *   2 D_layers     hold D : Backspace -> Delete, "/" key -> Up arrow
     *   3 BT_layers    hold B : Bluetooth profile select / clear
     *   4 scroll-layers  not reachable yet (all transparent); trackball scroll mode lives here
     *   5 snipe-layers   hold T : trackball moves slowly for precision (all keys transparent)
     *
     * The six bottom thumb keys (3 per half) are defined only on layer 0 and are
     * transparent on every other layer, so they always behave as layer 0 says.
     */
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E       &kp R       &lt 5 T     &kp Y       &kp U       &kp I      &kp O           &kp P           &kp BSLH
&kp CAPSLOCK      &kp A         &kp S         &lt 2 D     &lt 1 F     &kp G       &kp H       &kp J       &kp K      &kp L           &kp SEMI        &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C       &kp V       &lt 3 B     &kp N       &kp M       &kp COMMA  &kp DOT         &kp FSLH        &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LGUI      &kp LEFT_ALT  &kp SPACE   &kp SPACE   &mkp MCLK   &mkp LCLK   &mkp RCLK   &kp ENTER  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };

        F_layers {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };

        D_layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp DELETE
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp UP_ARROW &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };

        BT_layers {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder &scroll_encoder>;
        };
    };
};
