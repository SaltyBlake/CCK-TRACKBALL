#include <dt-bindings/zmk/matrix_transform.h>
#include "cck_ball-layouts.dtsi"

/*
 * Matrix columns use P0.09 and P0.10, which are the nRF52840 NFC pins.
 * On Zephyr 4.1 (ZMK main) they must be released to GPIO in devicetree.
 */
&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &cck_ball_layouts;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
              RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)                   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
              RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)                   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
              RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
              RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)                   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
              RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)                   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";
        row-gpios
            = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * Encoders: 24 detents per rotation, and this encoder sends 2 pulses per detent.
     * In upstream ZMK "steps" is the number of pulses per FULL rotation (24 x 2 = 48);
     * "triggers-per-rotation" below is the number of detents (24). That ratio gives
     * exactly one trigger per click.
     */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        status = "disabled";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        status = "disabled";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };
};
